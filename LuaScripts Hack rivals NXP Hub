local function SaveCollisionState()
    table.clear(SavedCollision)
    local character = LocalPlayer.Character
    if not character then return end
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            SavedCollision[object] = object.CanCollide
        end
    end
end
local function UpdateNoclip()
    local character = LocalPlayer.Character
    if not character then return end
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if NoclipEnabled or FlyEnabled then
                object.CanCollide = false
            else
                if SavedCollision[object] ~= nil then
                    object.CanCollide = SavedCollision[object]
                end
            end
        end
    end
end
local function SetNoclip(enabled)
    if enabled then SaveCollisionState() end
    NoclipEnabled = enabled
    UpdateNoclip()
end
