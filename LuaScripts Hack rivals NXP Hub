local ESP_TAG_NAME = "NXP_NameTag"
local ESP_HIGHLIGHT_NAME = "NXP_ESP_Highlight"
local function RemoveESPFromPlayer(player)
    if not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if head then
        local tag = head:FindFirstChild(ESP_TAG_NAME)
        if tag then tag:Destroy() end
    end
    local highlight = player.Character:FindFirstChild(ESP_HIGHLIGHT_NAME)
    if highlight then highlight:Destroy() end
end
local function RemoveESP()
    for _, player in ipairs(Players:GetPlayers()) do
        RemoveESPFromPlayer(player)
    end
end
local function CreateESP(player)
    if not ESPEnabled or player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not head or not root then return end
    local highlight = character:FindFirstChild(ESP_HIGHLIGHT_NAME)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = ESP_HIGHLIGHT_NAME
        highlight.Adornee = character
        highlight.Parent = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = Color3.fromHSV(0, 1, 1)
    end
    if not head:FindFirstChild(ESP_TAG_NAME) then
        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = ESP_TAG_NAME
        Billboard.Parent = head
        Billboard.AlwaysOnTop = true
        Billboard.Size = UDim2.new(0, 130, 0, 28)
        Billboard.StudsOffset = Vector3.new(0, 2.7, 0)
        local NameLabel = Instance.new("TextLabel")
        NameLabel.Name = "RainbowNameLabel"
        NameLabel.Parent = Billboard
        NameLabel.Size = UDim2.new(1, 0, 1, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = player.Name
        NameLabel.TextScaled = true
        NameLabel.Font = Enum.Font.GothamBlack
        NameLabel.TextColor3 = Color3.fromHSV(0, 1, 1)
        NameLabel.TextStrokeTransparency = 0
        NameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    end
end
local function RefreshESP()
    if not ESPEnabled then
        RemoveESP()
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        CreateESP(player)
    end
end
local function UpdateESPDistance()
    if not ESPEnabled then return end
    local localCharacter = LocalPlayer.Character
    if not localCharacter then return end
    local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    local rainbowColor = Color3.fromHSV((tick() % 5) / 5, 1, 1)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                local head = character:FindFirstChild("Head")
                local root = character:FindFirstChild("HumanoidRootPart")
                if head and root then
                    local distance = (localRoot.Position - root.Position).Magnitude
                    local tag = head:FindFirstChild(ESP_TAG_NAME)
                    local highlight = character:FindFirstChild(ESP_HIGHLIGHT_NAME)
                    if distance <= ESPDistance then
                        if not tag or not highlight then
                            CreateESP(player)
                            tag = head:FindFirstChild(ESP_TAG_NAME)
                            highlight = character:FindFirstChild(ESP_HIGHLIGHT_NAME)
                        end
                        if tag then 
                            tag.Enabled = true 
                            local nameLabel = tag:FindFirstChild("RainbowNameLabel")
                            if nameLabel then nameLabel.TextColor3 = rainbowColor end
                        end
                        if highlight then 
                            highlight.Enabled = true 
                            highlight.OutlineColor = rainbowColor
                        end
                    else
                        if tag then tag.Enabled = false end
                        if highlight then highlight.Enabled = false end
                    end
                end
            end
        end
    end
end
