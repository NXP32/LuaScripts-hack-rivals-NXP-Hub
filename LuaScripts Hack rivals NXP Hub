        LagStatus.Text = "FLY // DISABLED"
        LagStatus.TextColor3 = COLORS.Gray
    else
        StartFly()
        FlyButton.Text = "FLY: ON"
        FlyButton.BackgroundColor3 = COLORS.PurpleDark
        LagStatus.Text = "FLY // ACTIVE"
        LagStatus.TextColor3 = COLORS.Green
    end
end)
