local function CreateSlider(parent, y, minValue, maxValue, initialValue, callback)
    local container = Instance.new("Frame")
    container.Parent = parent
    container.ZIndex = MAIN_ZINDEX + 5
    container.Size = UDim2.new(1, 0, 0, 55)
    container.Position = UDim2.new(0, 0, 0, y)
    container.BackgroundTransparency = 1
    local bar = Instance.new("Frame")
    bar.Parent = container
    bar.ZIndex = MAIN_ZINDEX + 6
    bar.Size = UDim2.new(1, 0, 0, 8)
    bar.Position = UDim2.new(0, 0, 0.5, -4)
    bar.BackgroundColor3 = Color3.fromRGB(35, 38, 60)
    bar.BorderSizePixel = 0
    AddCorner(bar, 8)
    local fill = Instance.new("Frame")
    fill.Parent = bar
    fill.ZIndex = MAIN_ZINDEX + 7
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = COLORS.Cyan
    fill.BorderSizePixel = 0
    AddCorner(fill, 8)
    AddGradient(fill, COLORS.Purple, COLORS.Cyan, 0)
    local knob = Instance.new("Frame")
    knob.Parent = bar
    knob.ZIndex = MAIN_ZINDEX + 8
    knob.Size = UDim2.fromOffset(18, 18)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = COLORS.White
    knob.BorderSizePixel = 0
    AddCorner(knob, 10)
    AddStroke(knob, COLORS.Cyan, 2)
    local value = initialValue
    local sliderDragging = false
    local function SetValue(newValue)
        value = math.clamp(newValue, minValue, maxValue)
        local alpha = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        callback(value)
    end
    local function UpdateFromInput(input)
        if bar.AbsoluteSize.X <= 0 then return end
        local relativeX = input.Position.X - bar.AbsolutePosition.X
        local alpha = math.clamp(relativeX / bar.AbsoluteSize.X, 0, 1)
        local newValue = minValue + (maxValue - minValue) * alpha
        SetValue(newValue)
    end
    local function BeginSlider(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        IsDraggingSlider = true
        sliderDragging = true
        UpdateFromInput(input)
    end
    local function EndSlider(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = false
            IsDraggingSlider = false
        end
    end
    container.InputBegan:Connect(BeginSlider)
    bar.InputBegan:Connect(BeginSlider)
    fill.InputBegan:Connect(BeginSlider)
    knob.InputBegan:Connect(BeginSlider)
    UIS.InputChanged:Connect(function(input)
        if not sliderDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromInput(input)
        end
    end)
    UIS.InputEnded:Connect(EndSlider)
    SetValue(initialValue)
    return container, SetValue
end
