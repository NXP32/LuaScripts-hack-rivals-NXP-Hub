local function UpdateRainbowGUI()
    if not RainbowGUIEnabled then return end
    local rainbowColor = Color3.fromHSV((tick() % 4) / 4, 1, 1)

    -- 1. ÁP DỤNG LÊN CƠ THỂ MÌNH
    local char = LocalPlayer.Character
    if char then
        ApplyRainbowHighlight(char, rainbowColor)
        -- Fallback: Đổi màu trực tiếp
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("MeshPart") then
                if part.Name ~= "HumanoidRootPart" then
                    part.Color = rainbowColor
                end
            end
        end
    end

    -- 2. ÁP DỤNG LÊN GÓC NHÌN THỨ NHẤT TRONG CAMERA (Viewmodel tiêu chuẩn)
    for _, obj in ipairs(Camera:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            ApplyRainbowHighlight(obj, rainbowColor)
            -- Fallback
            for _, part in ipairs(obj:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("MeshPart") then
                    part.Color = rainbowColor
                elseif part:IsA("SpecialMesh") then
                    part.VertexColor = Vector3.new(rainbowColor.R, rainbowColor.G, rainbowColor.B)
                end
            end
        end
    end

    -- 3. QUÉT VIEWMODEL BỊ GIẤU NGOÀI WORKSPACE (Dành cho game như Rivals)
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= char then
            local name = string.lower(obj.Name)
            if name:match("viewmodel") or name:match("arms") or name:match("client") or name:match("weapon") then
                ApplyRainbowHighlight(obj, rainbowColor)
                -- Fallback
                for _, part in ipairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("MeshPart") then
                        part.Color = rainbowColor
                    end
                end
            end
        end
    end
end

