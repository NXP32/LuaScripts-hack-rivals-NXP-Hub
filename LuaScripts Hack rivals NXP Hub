local function StopTeleportAttachment()
    if TeleportConnectionStepped then
        TeleportConnectionStepped:Disconnect()
        TeleportConnectionStepped = nil
    end
    if TeleportConnectionRender then
        TeleportConnectionRender:Disconnect()
        TeleportConnectionRender = nil
    end
    
    local curChar = LocalPlayer.Character
    if curChar then
        local myHumanoid = curChar:FindFirstChildOfClass("Humanoid")
        if myHumanoid then
            myHumanoid.PlatformStand = false
        end
    end
    TeleportTargetPlayer = nil
end
local function SyncCharacterToHead()
    if not TeleportTargetPlayer then return end
    local curChar = LocalPlayer.Character
    local tarChar = TeleportTargetPlayer.Character
    if not curChar or not tarChar then return end
    local targetHead = tarChar:FindFirstChild("Head")
    local myRoot = curChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = curChar:FindFirstChildOfClass("Humanoid")
    if not targetHead or not myRoot then return end
    
    if myHumanoid then
        myHumanoid.PlatformStand = true
    end
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    
    local targetPos = targetHead.Position
    local myPos = targetPos + Vector3.new(0, TeleportHeightOffset, 0)
    local lookCFrame = CFrame.lookAt(myPos, targetPos)
    
    myRoot.CFrame = lookCFrame
    Camera.CFrame = lookCFrame
end
local function TeleportToPlayer(player)
    if not player then
        TeleportStatus.Text = "TELEPORT // NO TARGET"
        TeleportStatus.TextColor3 = COLORS.Red
        return false
    end
    local character = LocalPlayer.Character
    local targetCharacter = player.Character
    if not character or not targetCharacter then
        TeleportStatus.Text = "TELEPORT // TARGET NOT READY"
        TeleportStatus.TextColor3 = COLORS.Red
        return false
    end
    local myRoot = character:FindFirstChild("HumanoidRootPart")
    local targetHead = targetCharacter:FindFirstChild("Head")
    if not myRoot or not targetHead then
        TeleportStatus.Text = "TELEPORT // PART NOT FOUND"
        TeleportStatus.TextColor3 = COLORS.Red
        return false
    end
    StopTeleportAttachment()
    local originalCFrame = myRoot.CFrame
    TeleportTargetPlayer = player
    TeleportStatus.Text = "TELEPORT // LOCK: " .. player.Name
    TeleportStatus.TextColor3 = COLORS.Green
    AdminStatus.Text = "LOCKED ON TOP → " .. player.Name
    StatusLabel.Text = "STICKING TO " .. player.Name
    
    TeleportConnectionStepped = RunService.Stepped:Connect(SyncCharacterToHead)
    TeleportConnectionRender = RunService.RenderStepped:Connect(SyncCharacterToHead)
    
    if TeleportBackEnabled then
        local delayTime = math.max(0, TeleportBackDelay)
        task.delay(delayTime, function()
            StopTeleportAttachment()
            local currentCharacter = LocalPlayer.Character
            local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
            
            if currentRoot then
                currentRoot.AssemblyLinearVelocity = Vector3.zero
                currentRoot.AssemblyAngularVelocity = Vector3.zero
                currentRoot.CFrame = originalCFrame
            end
            TeleportStatus.Text = "TELEPORT BACK // COMPLETE"
            TeleportStatus.TextColor3 = COLORS.Cyan
            AdminStatus.Text = "RETURN // COMPLETE"
            StatusLabel.Text = "NXP SYSTEM // READY"
        end)
    end
    return true
end
