local function IsAimPlayerSelected(player)
    return AimSelectedPlayers[player] == true
end
local function CreateAimPlayerSelectionButton(player)
    local button = Instance.new("TextButton")
    button.Name = "AimPlayer_" .. tostring(player.UserId)
    button.Parent = AimPlayerList
    button.ZIndex = MAIN_ZINDEX + 8
    button.Size = UDim2.new(1, 0, 0, 35)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
