    button.BackgroundColor3 = COLORS.Panel2
    button.BorderSizePixel = 0
    AddCorner(button, 8)
    local stroke = AddStroke(button, COLORS.Purple, 1)
    local function UpdateButton()
        if IsAimPlayerSelected(player) then
            button.Text = "✓  " .. player.Name
            button.BackgroundColor3 = COLORS.PurpleDark
            stroke.Color = COLORS.Cyan
        else
            button.Text = "☐  " .. player.Name
            button.BackgroundColor3 = COLORS.Panel2
            stroke.Color = COLORS.Purple
        end
    end
    UpdateButton()
    button.MouseButton1Click:Connect(function()
        if IsAimPlayerSelected(player) then
            AimSelectedPlayers[player] = nil
        else
            AimSelectedPlayers[player] = true
        end
        UpdateButton()
    end)
end
local function RefreshAimPlayerList()
    for _, child in ipairs(AimPlayerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for player in pairs(AimSelectedPlayers) do
        if player.Parent ~= Players then AimSelectedPlayers[player] = nil end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then CreateAimPlayerSelectionButton(player) end
    end
end
AimClearSelectionButton.MouseButton1Click:Connect(function()
    table.clear(AimSelectedPlayers)
    RefreshAimPlayerList()
end)
