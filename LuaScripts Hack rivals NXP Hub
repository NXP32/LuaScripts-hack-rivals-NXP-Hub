-- MAIN RENDER LOOP
------------------------------------------------------------
local DistanceTimer = 0
RunService.RenderStepped:Connect(function(deltaTime)
    if NoclipEnabled or FlyEnabled then
        UpdateNoclip()
    end
    if ESPEnabled then
        DistanceTimer = DistanceTimer + deltaTime
        if DistanceTimer >= 0.05 then
            DistanceTimer = 0
            UpdateESPDistance()
        end
    end
    if RainbowGUIEnabled then
        UpdateRainbowGUI()
    end
    if FlyEnabled and FlyBodyVelocity and FlyBodyGyro then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local moveDir = Vector3.zero
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                if moveDir.Magnitude > 0 then
                    moveDir = moveDir.Unit
                end
                FlyBodyVelocity.Velocity = moveDir * FlySpeed
                FlyBodyGyro.CFrame = Camera.CFrame
            end
        end
    end
    if AutoShotEnabled then
        local target = Mouse.Target
        local isHoveringEnemy = false
        if target and target.Parent then
            local enemyModel = target.Parent:IsA("Accessory") and target.Parent.Parent or target.Parent
            local enemyPlayer = Players:GetPlayerFromCharacter(enemyModel)
            
            if enemyPlayer and enemyPlayer ~= LocalPlayer and IsAimPlayerSelected(enemyPlayer) then
                local enemyHumanoid = enemyModel:FindFirstChildOfClass("Humanoid")
                if enemyHumanoid and enemyHumanoid.Health > 0 then
                    isHoveringEnemy = true
                end
            end
        end
        if isHoveringEnemy then
            if AutoShotMode == "SINGLE" then
                if not SingleFired then
                    if mouse1click then pcall(mouse1click) end
                    SingleFired = true
                end
            elseif AutoShotMode == "RAPID" then
                if mouse1click then pcall(mouse1click) end
            elseif AutoShotMode == "HOLD" then
                if not IsShooting then
                    if mouse1press then pcall(mouse1press) end
                    IsShooting = true
                end
            end
        else
            SingleFired = false
            if AutoShotMode == "HOLD" and IsShooting then
                if mouse1release then pcall(mouse1release) end
                IsShooting = false
            end
        end
    else
        SingleFired = false
        if IsShooting then
            if mouse1release then pcall(mouse1release) end
            IsShooting = false
        end
    end
end)
